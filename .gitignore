# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# local HTTPS certs from `next dev --experimental-https`
/certificates

# typescript
*.tsbuildinfo
next-env.d.ts

# Large design sources (GIF/PSD/AE exports). Keep locally, never commit —
# a 16MB binary in history bloats every future clone.
/design-source/

# Stray screenshots dropped in the repo root (referenced art lives in
# public/art/ and is tracked there).
/Screenshot *
/Capture.*
/*.PNG
