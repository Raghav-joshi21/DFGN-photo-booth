{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date) hook fired\" >> /tmp/claude-hook-check.txt; \"$CLAUDE_PROJECT_DIR/scripts/auto-commit.sh\"",
            "async": false,
            "timeout": 60,
            "statusMessage": "Auto-committing\u2026"
          }
        ]
      }
    ]
  }
}
