{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/auto-commit.sh\"",
            "async": true,
            "timeout": 60,
            "statusMessage": "Auto-committing\u2026"
          }
        ]
      }
    ]
  }
}
