# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# --- Supabase (client-safe) ------------------------------------------------
# These are exposed to the browser (NEXT_PUBLIC_ prefix). Safe to ship: access
# is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only) ------------------------------------------------
# Bypasses Row Level Security. Server-only — used by app/api/* routes. Do NOT
# add a NEXT_PUBLIC_ prefix and never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Image AI provider (server-only) ---------------------------------------
# Used by app/api/ai-edit to stylize uploaded selfies. Server-only.
IMAGE_AI_API_KEY=your-image-ai-api-key
