# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# --- Supabase (client-safe) ------------------------------------------------
# These are exposed to the browser (NEXT_PUBLIC_ prefix). Safe to ship: access
# is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only) ------------------------------------------------
# Bypasses Row Level Security. Server-only — used by app/api/* routes. Do NOT
# add a NEXT_PUBLIC_ prefix and never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Snap Camera Kit (client-safe) -----------------------------------------
# Live lens filters on the booth's self-camera. Both values come from the Snap
# Developer portal at https://developer.snapchat.com — create an app, then take
# the API token from its Camera Kit credentials and the group ID from the Lens
# Group you publish your lenses into.
#
# Optional: leave them blank and the booth simply shows an unfiltered preview.
NEXT_PUBLIC_CAMERA_KIT_API_TOKEN=your-camera-kit-api-token
NEXT_PUBLIC_CAMERA_KIT_LENS_GROUP_ID=your-lens-group-id

# --- Image AI provider (server-only) ---------------------------------------
# Google AI Studio API key (https://aistudio.google.com/apikey). Used by
# app/api/ai-edit, which sends each photo to Gemini's image model and writes the
# stylized result back to `photos.edited_url`. Server-only.
#
# NOTE: the image models have NO free tier (the API reports a quota of 0), so
# the project behind this key needs billing enabled. Gemini 2.5 Flash Image is
# ~$0.039 per photo.
#
# Optional: leave it blank and photos still reach the wall, just unstylized.
IMAGE_AI_API_KEY=your-image-ai-api-key
